generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  BYUER
  REALTOR
  ADMIN
}

enum PropertyType {
  RESIDENTIAL
  CONDO
}

//User Table
model User {
  id                    Int         @id      @default(autoincrement())   
  name                  String
  phone                 String
  email                 String      @unique
  password              String      
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  user_type             UserType
  homes                 Home[]
  buyer_message         Message[]            @relation("buyer_message")
  realtor_message       Message[]            @relation("realtor_message")
}

//Home Table
model Home {
  id                    Int          @id     @default(autoincrement()) 
  address               String         
  number_of_bedrooms    Float
  number_of_bathrooms   Float
  city                  String
  listed_date           DateTime             @default(now())
  price                 Float     
  land_size             Float
  propertyType          PropertyType
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  images                Image[]
  realtor_id            Int
  realtor               User                 @relation(fields: [realtor_id], references: [id]) //One to Many Relationship
  message               Message[]        
}

//Image Table
model Image {
  id                    Int           @id    @default(autoincrement())
  url                   String
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  home_id               Int
  home                  Home                 @relation(fields: [home_id], references: [id]) //One to Many Relationship
}

//Message Table
model Message {
  id                    Int           @id    @default(autoincrement())
  message               String
  home_id               Int
  home                  Home                 @relation(fields: [home_id], references: [id]) //One to Many Relationship
  realtor_id            Int
  realtor               User                 @relation("realtor_message", fields: [realtor_id], references: [id])
  buyer_id              Int
  buyer                 User                 @relation("buyer_message" ,fields: [buyer_id], references: [id])
}

